<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AramisBeauty" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/burgundy</item>
        <item name="colorPrimaryDark">@color/burgundy_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
    </style>

    <style name="Theme.AramisBeauty.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/burgundy</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
        <item name="postSplashScreenTheme">@style/Theme.AramisBeauty</item>
    </style>

    <style name="Widget.AramisBeauty.Button" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/burgundy</item>
    </style>

    <style name="Widget.AramisBeauty.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/burgundy</item>
        <item name="strokeColor">@color/burgundy</item>
    </style>
</resources>
