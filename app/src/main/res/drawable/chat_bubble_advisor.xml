<?xml version="1.0" encoding="utf-8"?>
<!-- Telegram-style advisor bubble (v1.6.2): near-white translucent card,
     bright rim, top sheen. Text on it is dark (see ChatActivity). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E8FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#E6FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="#33FFFFFF"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
