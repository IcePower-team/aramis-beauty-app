<?xml version="1.0" encoding="utf-8"?>
<!-- v1.6.9 (redesigned 2026-11-26): modern update dialog that links OUT to
     Cafe Bazaar. Emoji sits in a small pink badge, version is a pill chip,
     buttons are full-pill. Same view IDs and behavior as before — look only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_update_background"
    android:elevation="12dp"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="28dp"
    android:paddingEnd="28dp"
    android:paddingBottom="24dp">

    <!-- Small emoji badge instead of a big standalone glyph -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:background="@drawable/dialog_update_emoji_badge">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🎉"
            android:textSize="20sp" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:text="نسخه جدید اومده! ✨"
        android:textColor="@color/burgundy"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Version as a small pink pill chip (text set by code) -->
    <TextView
        android:id="@+id/bazaar_update_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:background="@drawable/dialog_update_version_chip"
        android:paddingStart="12dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp"
        android:paddingBottom="5dp"
        android:text="نسخه جدید"
        android:textColor="@color/deals_pink"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/bazaar_update_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:ellipsize="end"
        android:gravity="center"
        android:lineSpacingExtra="5dp"
        android:maxLines="6"
        android:textColor="#444444"
        android:textSize="15sp" />

    <!-- Actions row: prominent download CTA + faint borderless "later" -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_bazaar_download"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:background="@drawable/btn_update_primary"
            android:text="دانلود از کافه بازار"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btn_bazaar_later"
            android:layout_width="wrap_content"
            android:layout_height="54dp"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="بعداً"
            android:textColor="#9C9C9C"
            android:textSize="14sp"
            app:backgroundTint="@null" />
    </LinearLayout>

</LinearLayout>
